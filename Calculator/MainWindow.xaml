                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>
                
            <Button Content="➖" 
                 Name="btnSubtract"
                 Height="55"
                 Width="80"
                 Background="Transparent"
                 BorderBrush="Transparent"
                 FontFamily="Segoe Script"
                 FontSize="12"
                 Click="OnOperatorButtonClick"/>
            
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,390,0,0">

            <Button Content="1"
                    Name="btnD1"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>

            <Button Content="2"
                    Name="btnD2"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>
             
            <Button Content="3"
                    Name="btnD3"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>
              
            <Button Content="➕" 
                    Name="btnAdd"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="12"
                    Click="OnOperatorButtonClick"/>
               
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,442.5,0,0">

            <Button Name="btnPlusMinus"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="OnOperatorButtonClick">
                    <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock.Inlines>
                            <Run Text="➕" FontSize="12" BaselineAlignment="Superscript" />
                            <Run Text="/"  FontWeight="Bold" FontSize="16" BaselineAlignment="TextTop" />
                            <Run Text="➖" FontSize="12" BaselineAlignment="Subscript"/>
                        </TextBlock.Inlines>
                    </TextBlock>
            </Button>

            <Button Content="0"
                    Name="btnD0"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>
               
            <Button Content="•"
                    Name="btnOemPeriod"
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="20"
                    Click="Button_Click"/>
               
            <Button Name="btnEqual" 
                    Height="55"
                    Width="80"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontFamily="Segoe Script"
                    FontSize="12"
                    Click="OnOperatorButtonClick">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- First line -->
                        <Rectangle Fill="Black" Height="2" Grid.Row="0" />

                        <!-- Second line -->
                        <Rectangle Fill="Black" Height="2" Grid.Row="1" Margin="0,5,0,0"/>
                    </Grid>
            </Button>

        </StackPanel>
            
    </Grid>
        

    <Grid x:Name="ProgrammerModeGrid">
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5">

                <Button Content="🛠️" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" 
                        Height="40" 
                        Width="40" 
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        Opacity="1"
                        Click="Settings"/>

                <Label Content="Programmer" 
                   TextBlock.FontFamily="Segoe Script"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                </Label>

        </StackPanel>

        <TextBox Name="textBoxProgrammer"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 BorderBrush="Gray" 
                 BorderThickness="2" 
                 Margin="0,74,0,0"
                 Height="37"
                 Width="320"
                 Focusable="True"
                 PreviewTextInput="TextBox_PreviewTextInput"
                 InputScope="Number" 
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 FontSize="22"
                 FontFamily="Segoe Script"
                 IsReadOnly="True">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
        </TextBox>

        <StackPanel Margin="0,117,0,0">

                <!-- HEX -->
                <Button x:Name="btnHex" Style="{x:Null}" Width="360" Height="40" Click="BaseButton_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="HEX" FontSize="16" Width="60" VerticalAlignment="Center" FontFamily="Segoe Script"/>
                        <TextBox x:Name="hexTextBox" Width="300" Height="40" FontSize="20" IsReadOnly="True" FontFamily="Segoe Script" BorderThickness="0" Text="0"/>
                    </StackPanel>
                </Button>

                <!-- DEC -->
                <Button x:Name="btnDec" Style="{x:Null}" Width="360" Height="40" Click="BaseButton_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="DEC" FontSize="16" Width="60" VerticalAlignment="Center" FontFamily="Segoe Script"/>
                        <TextBox x:Name="decimalTextBox" Width="300" Height="40" FontSize="20" IsReadOnly="True" FontFamily="Segoe Script" BorderThickness="0" Text="0"/>
                    </StackPanel>
                </Button>

                <!-- OCT -->
                <Button x:Name="btnOct" Style="{x:Null}" Width="360" Height="40" Click="BaseButton_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="OCT" FontSize="16" Width="60" VerticalAlignment="Center" FontFamily="Segoe Script"/>
                        <TextBox x:Name="octalTextBox" Width="300" Height="40" FontSize="20" FontFamily="Segoe Script" IsReadOnly="True" BorderThickness="0" Text="0" />
                    </StackPanel>
                </Button>

                <!-- BIN -->
                <Button x:Name="btnBin" Style="{x:Null}" Width="360" Height="40" Click="BaseButton_Click" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <TextBlock Text="BIN" FontSize="16" Width="60" VerticalAlignment="Center" FontFamily="Segoe Script"/>
                        <TextBox x:Name="binaryTextBox" Width="300" Height="40" FontSize="20" FontFamily="Segoe Script" IsReadOnly="True" BorderThickness="0" Text="0" />
                    </StackPanel>
                </Button>

        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,281,0,0">

             <Button Content="A" 
                     Name="btnA"
                     Height="38"
                     Width="64"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontSize="16"
                     FontFamily="Segoe Script"
                     Click="Button_Click"/>

             <Button Content="NOT" 
                     Height="38"
