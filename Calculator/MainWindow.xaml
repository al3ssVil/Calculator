                     Width="64"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontSize="16"
                     FontFamily="Segoe Script"
                     Click="C_Button"/>
               
             <Button Content="🔄" 
                     Height="38"
                     Width="64"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontSize="14"
                     FontFamily="Segoe Script"
                     Click="Button_Click"/>
             
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,317,0,0">

             <Button Content="B"
