                            <Run Text="➕" FontSize="8" BaselineAlignment="Superscript" />
                            <Run Text="/"  FontWeight="Bold" FontSize="11" BaselineAlignment="TextTop" />
                            <Run Text="➖" FontSize="8" BaselineAlignment="Subscript"/>
                        </TextBlock.Inlines>
                    </TextBlock>
             </Button>

             <Button Content="0"
                     Name="btnNumPad0"
                     Height="38"
                     Width="64"
