        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,353,0,0">

             <Button Content="C"
                     Name="btnC"
                     Height="38"
                     Width="64"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontFamily="Segoe Script"
                     FontSize="16"
